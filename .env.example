# ===========================================
# DocMind - Environment Variables Example
# Ye file copy karke ".env" naam se save karein
# aur apni real API keys yahan daalein.
# ===========================================

# Flask secret key - session security ke liye (random string daalein)
SECRET_KEY=change-this-to-a-random-secret-string

# Groq API Key - https://console.groq.com/keys se free milegi
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace API Key - https://huggingface.co/settings/tokens se free milegi
HF_API_KEY=your_huggingface_api_key_here

# Database URL (SQLite - default, kuch change karne ki zaroorat nahi)
DATABASE_URL=sqlite:///docmind.db

# Upload folder path
UPLOAD_FOLDER=uploads

# Max upload size in MB
MAX_UPLOAD_MB=10
